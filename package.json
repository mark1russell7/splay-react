{
  "$schema": "https://json.schemastore.org/package",
  "name": "@mark1russell7/splay-react",
  "version": "1.0.0",
  "description": "React adapter for [splay](https://github.com/mark1russell7/splay) recursive data renderer.",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .tsbuildinfo"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mark1russell7/splay-react.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "bugs": {
    "url": "https://github.com/mark1russell7/splay-react/issues"
  },
  "homepage": "https://github.com/mark1russell7/splay-react#readme",
  "dependencies": {
    "@mark1russell7/splay": "^0.2.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@types/react": "^19.0.0",
    "@mark1russell7/cue": "^1.0.2",
    "vite": "^6.0.0"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "peerDependencies": {
    "react": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
