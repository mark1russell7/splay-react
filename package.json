{
  "$schema": "https://json.schemastore.org/package",
  "name": "@mark1russell7/splay-react",
  "version": "1.0.4",
  "description": "React adapter for [splay](https://github.com/mark1russell7/splay) recursive data renderer.",
  "main": "./src/index.ts",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json && pnpm --filter @splay-react/site run typecheck",
    "test": "pnpm --filter @splay-react/site run test",
    "clean": "rm -rf dist .tsbuildinfo",
    "check:conventions": "conventions check",
    "check:api": "api-report check"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mark1russell7/splay-react.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "bugs": {
    "url": "https://github.com/mark1russell7/splay-react/issues"
  },
  "homepage": "https://github.com/mark1russell7/splay-react#readme",
  "dependencies": {
    "@mark1russell7/splay": "^0.2.0"
  },
  "devDependencies": {
    "@mark1russell7/api-report": "^0.5.3",
    "@mark1russell7/conventions": "^0.41.0",
    "@mark1russell7/cue": "^2.0.0",
    "@types/react": "^19.0.0",
    "@vitest/coverage-v8": "^5.0.3",
    "typescript": "^5.9.3",
    "vite": "^6.0.0"
  },
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo"
  ],
  "sideEffects": false,
  "peerDependencies": {
    "react": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      }
    }
  }
}
